# Application
APP_NAME=TikTok Product Research
APP_VERSION=1.0.0
DEBUG=True

# Database (Postgres connection - e.g. Neon)
PGHOST=your-database-host-here
PGDATABASE=your-database-name-here
PGUSER=your-database-user-here
PGPASSWORD=your-database-password-here
PGSSLMODE=require
PGCHANNELBINDING=require

# LLM (Groq) - must support "json_mode" in models.json
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Scoring weights (must sum to 1.0)
SCORE_WEIGHT_SALES_VELOCITY=0.4
SCORE_WEIGHT_GROWTH=0.25
SCORE_WEIGHT_RATING=0.15
SCORE_WEIGHT_COMPETITION=0.2
